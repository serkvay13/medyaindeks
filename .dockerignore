# Gizli ayarlar — imaja ASLA girmez (Cloud Run'da kimlik servis hesabından gelir,
# parola yalnızca SHA-256 özeti olarak ortam değişkeninde durur)
.streamlit/secrets.toml
.streamlit/panel_parolasi.txt
# Veri: imaja girmez, panel bulut arşivine düşer
data/
dosyalar/
# Ortam ve derleme artıkları
venv/
venv.old/
__pycache__/
*.pyc
.git/
.claude/
# Panelde kullanılmayanlar
cases/
llm/*
!llm/__init__.py
!llm/butce.py
!llm/fiyatlar.toml
ajan/
vitrin/
tests/
*.md
!yasal/*.md
# Platform: istem dosyaları ve vaka anlatıları Markdown'dır ve imaja girmelidir
!medya/**/*.md
!vakalar/**/*.md
# Vaka paketlerindeki referans karşılaştırma dosyaları yalnızca testler içindir
vakalar/*/referans/
